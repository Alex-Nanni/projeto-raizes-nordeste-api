            ],
            "url": "http://localhost:3000/api/pedidos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": 1,\n  \"unidadeId\": 1,\n  \"canalPedido\": \"APP\",\n  \"itens\": [{\"produtoId\": 10, \"quantidade\": 1}]\n}"
            }
          }
        },
